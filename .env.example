# ============================================================
# DIAM-YARAAM — Modèle de configuration des variables d'environnement
# Copiez ce fichier vers .env :
#   cp .env.example .env (Linux/macOS) ou copy .env.example .env (Windows)
# ATTENTION : Ne committez JAMAIS le fichier .env réel dans Git !
# ============================================================

# ----- BASE DE DONNEES POSTGRESQL -----
POSTGRES_DB=diam_yaraam
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changer_ce_mot_de_passe_en_production

# Mot de passe utilisé par les microservices Spring Boot pour se connecter à PostgreSQL
SPRING_DATASOURCE_PASSWORD=changer_ce_mot_de_passe_en_production

# ----- SECURITE JWT (HS256) -----
# Clé secrète cryptographique partagée (minimum 256 bits / 32 caractères alphanumériques)
JWT_SECRET=diam_yaraam_super_secret_jwt_key_2026_minimum_256_bits_for_hmac_sha256_security

# ----- DECOUVERTE DE SERVICES EUREKA -----
EUREKA_SERVER_URL=http://discovery-server:8761/eureka/

# ----- ROUTAGE DES SERVICES INTERNES -----
IA_SERVICE_URL=http://ia-service:8089
WS_BROADCAST_URL=http://rdv-service:8084/ws-broadcast

# ----- SERVICE IA (FASTAPI & OPENROUTER) -----
# Clé API OpenRouter pour l'accès aux LLMs (RAG médical et triage d'urgence)
OPENROUTER_API_KEY=sk-or-v1-VOTRE_CLE_OPENROUTER_ICI
LLM_MODEL=openai/gpt-4o-mini
IA_SERVICE_PORT=8089
DOCUMENTS_PATH=/app/documents

# ----- TELECONSULTATION WEBRTC (LIVEKIT CLOUD) -----
LIVEKIT_URL=https://votre-instance.livekit.cloud
LIVEKIT_API_KEY=votre_api_key_livekit
LIVEKIT_API_SECRET=votre_api_secret_livekit

# ----- CORS -----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8088,http://localhost:3000

# ----- OTP BYPASS (DEVELOPPEMENT UNIQUEMENT) -----
OTP_BYPASS_ENABLED=false
OTP_BYPASS_CODE=456321
