<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.diamyaraam</groupId>
        <artifactId>diam-yaraam</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>discovery-server</artifactId>
    <name>DIAM-YARAAM :: Discovery Server (Eureka)</name>

    <!--
        DISCOVERY SERVER — Eureka Server
        ================================
        En microservices, les services doivent se trouver les uns les autres.
        Au lieu d'avoir des URLs fixes (http://localhost:8082),
        chaque service s'enregistre auprès du Discovery Server.

        Flux :
          1. auth-service démarre → s'enregistre sur Eureka : "Je suis AUTH-SERVICE sur port 8081"
          2. rdv-service veut appeler auth-service → demande à Eureka : "Où est AUTH-SERVICE ?"
          3. Eureka répond : "http://localhost:8081"
          4. rdv-service appelle directement auth-service

        Avantage : si un service change de port ou tourne sur plusieurs instances,
        les autres services n'ont rien à changer.
    -->

    <dependencies>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
